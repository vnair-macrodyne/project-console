# Terraform — never commit state (holds secret values) or local vars/creds.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# Variable files carry secrets / connection detail. Commit only the *.example.
*.tfvars
*.auto.tfvars
!*.tfvars.example

# Plan output can embed secrets
*.tfplan

# Backend config (carries the state storage account name; keep local)
backend.hcl
