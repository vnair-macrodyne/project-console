# Project Console — copy to .env and fill in.  NEVER commit .env (it's gitignored).
# Secrets are read from the environment; .env is auto-loaded at startup (python-dotenv).

# Which tenant profile to use
CONSOLE_TENANT=tenant_macrodyne.json

# Console store login — write on the Console DB only, no vendor-DB access
CONSOLE_STORE_USER=
CONSOLE_STORE_PWD=
# ...or use Windows auth instead of user/pwd:
# CONSOLE_STORE_TRUSTED=1
# Optional overrides (else taken from the tenant profile):
# CONSOLE_STORE_SERVER=MACRO-ETO-SVR\SQLEXPRESS
# CONSOLE_STORE_DB=Macrodyne_Reporting

# ETO read-only login (vendor DB)
ETO_USER=TotalETOReportWriter
ETO_PWD=
# ...or set use_windows_auth in the tenant profile and leave these blank.
