# Project Console — container runtime settings.
#
#   cp .env.docker.example .env.docker    # then fill in the blanks
#   docker run --env-file .env.docker -p 8000:8000 project-console:latest
#
# .env.docker holds SECRETS — it is gitignored (*.env). NEVER commit a filled-in copy.
# This file (the *.example) carries no secrets and is safe to commit.
#
# The same image serves on-prem (this file) and, later, Azure/Entra (a different env set —
# see the "AZURE / ENTRA" block at the bottom). Only the env changes; the image does not.

# ── tenant profile ─────────────────────────────────────────────────────────────
# Baked into the image; override only for a different customer profile.
CONSOLE_TENANT=tenant_macrodyne.json

# prod | staging  — staging points the Reporting store at Macrodyne_Reporting_Staging.
CONSOLE_ENV=prod

# ── session signing key (REQUIRED) ──────────────────────────────────────────────
# A FIXED random string. Without it, sessions reset on every container restart and every
# scaled-out replica has a different key. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONSOLE_SECRET_KEY=

# ── database auth — SQL logins (REQUIRED in a container) ────────────────────────
# Windows/Trusted auth cannot work here (Linux, not domain-joined), so both stores use
# SQL logins. The Reporting login writes on the Console DB only; ETO is read-only.
CONSOLE_STORE_USER=MacrodyneConsoleSvc
CONSOLE_STORE_PWD=
ETO_USER=TotalETOReportWriter
ETO_PWD=

# DB server/instance. If the container host cannot resolve the ETO box by name, or cannot
# reach the SQL Browser (UDP 1434) that resolves the SQLEXPRESS *named instance*, point at a
# STATIC TCP port instead — e.g. CONSOLE_STORE_SERVER=MACRO-ETO-SVR,1433  (host,port form).
# See DEPLOY_CONTAINER.md → "Reaching SQL Server from the container".
# CONSOLE_STORE_SERVER=MACRO-ETO-SVR\SQLEXPRESS
# CONSOLE_STORE_DB=Macrodyne_Reporting

# ── authentication (on-prem: LDAP form-login) ───────────────────────────────────
# pywin32 is absent on this Linux image, so the Windows LogonUser path is unavailable and
# the app authenticates people by binding to the DC with the username+password they type.
CONSOLE_AUTH=ldap
# A domain-controller hostname the container can reach on 389 (NTLM, no cert needed).
CONSOLE_LDAP_SERVER=dc01.macrodynepress.com
# UPN suffix — users sign in as user@this.
CONSOLE_AD_DOMAIN=macrodynepress.com
# NETBIOS short domain for the NTLM bind. Set it explicitly — the auto-guess from the UPN
# ("MACRODYNE") is WRONG here (the real short name has a zero: MACR0DYNE).
CONSOLE_AD_NETBIOS=MACR0DYNE
# Bind style: ntlm (389, no cert — default) | simple (LDAPS 636, needs a valid DC cert).
# CONSOLE_LDAP_METHOD=ntlm
# CONSOLE_LDAP_SSL=0

# ── serving ─────────────────────────────────────────────────────────────────────
# TLS is terminated in front of the container (reverse proxy / platform), never by waitress.
# Leave CONSOLE_HTTPS unset so the app binds 0.0.0.0 inside the container; publish the port
# behind your TLS proxy. Only the secure-cookie hardening keys off CONSOLE_HTTPS=1.
# CONSOLE_HTTPS=1
CONSOLE_PORT=8000
CONSOLE_THREADS=8

# ════════════════════════════════════════════════════════════════════════════════
# AZURE / ENTRA (later phase — NOT used on-prem). Left here as the seam to fill in:
#   CONSOLE_AUTH=entra              # new backend in console_web/auth.py (OIDC via Entra)
#   CONSOLE_STORE_SERVER=<name>.database.windows.net
#   CONSOLE_STORE_DB=Macrodyne_Reporting
#   (Reporting store on Azure SQL via managed identity — no CONSOLE_STORE_USER/PWD)
# ETO stays reachable over the site-to-site/VPN link, still read-only, still SQL-auth.
# ════════════════════════════════════════════════════════════════════════════════
