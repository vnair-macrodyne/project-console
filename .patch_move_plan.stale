import io, os, sys
F = os.path.join(os.environ.get("BASE", "."), "console_web", "templates", "index.html")
EDITS = []

# 1) menu items (<a>) should not be underlined
EDITS.append((
    "  .mi{display:block;width:100%;text-align:left;border:0;background:none;padding:9px 11px;border-radius:7px;",
    "  .mi{display:block;width:100%;text-align:left;border:0;background:none;padding:9px 11px;border-radius:7px;text-decoration:none;",
    1))

# 2) move Project Plan from a top-right link INTO the Project Management dropdown (same pm+ RBAC)
OLD = (
"  menus().forEach(([m,items])=>{\n"
"    const g=document.createElement('div'); g.className='navgrp';\n"
"    const active = items.some(q=>q.id===state.selQuery);\n"
"    if(active) g.classList.add('active');\n"
"    const btn=document.createElement('button'); btn.className='navtop'; btn.textContent=m+' ▾';\n"
"    btn.onclick=(e)=>{ e.stopPropagation(); const open=g.classList.contains('open'); closeMenus(); if(!open) g.classList.add('open'); };\n"
"    g.appendChild(btn);\n"
"    const menu=document.createElement('div'); menu.className='navmenu';\n"
"    items.forEach(q=>{\n"
"      const mi=document.createElement('button'); mi.className='mi'+(q.id===state.selQuery?' sel':'');\n"
"      mi.innerHTML=`<div>${q.label}</div><div class=\"mid\">${q.desc}</div>`;\n"
"      mi.onclick=()=>{ closeMenus(); selectReport(q.id); };\n"
"      menu.appendChild(mi);\n"
"    });\n"
"    g.appendChild(menu); nav.appendChild(g);\n"
"  });\n"
"  // role-gated links (right side): Project Plan (pm+ — now also owns budget/efficacy + add/remove),\n"
"  // Admin (admin). PM Budgets folded into Project Plan (2026-09-12).\n"
"  const role=(state.me&&state.me.role)||'viewer', rank={viewer:1,pm:2,admin:3};\n"
"  if((rank[role]||1)>=2){\n"
"    const pl=document.createElement('a'); pl.className='navtop pmlink'; pl.href='/plan';\n"
"    pl.textContent='Project Plan';\n"
"    pl.title='Add/remove projects, budget & efficacy, schedule & progress'; nav.appendChild(pl);\n"
"  }\n")

NEW = (
"  // RBAC rank: Project Plan is pm+, Users/Admin is admin. (2026-11-01: Project Plan moved from a\n"
"  // top-right link INTO the Project Management menu -- same pm+ gate.)\n"
"  const role=(state.me&&state.me.role)||'viewer', rank={viewer:1,pm:2,admin:3};\n"
"  menus().forEach(([m,items])=>{\n"
"    const g=document.createElement('div'); g.className='navgrp';\n"
"    const active = items.some(q=>q.id===state.selQuery);\n"
"    if(active) g.classList.add('active');\n"
"    const btn=document.createElement('button'); btn.className='navtop'; btn.textContent=m+' ▾';\n"
"    btn.onclick=(e)=>{ e.stopPropagation(); const open=g.classList.contains('open'); closeMenus(); if(!open) g.classList.add('open'); };\n"
"    g.appendChild(btn);\n"
"    const menu=document.createElement('div'); menu.className='navmenu';\n"
"    items.forEach(q=>{\n"
"      const mi=document.createElement('button'); mi.className='mi'+(q.id===state.selQuery?' sel':'');\n"
"      mi.innerHTML=`<div>${q.label}</div><div class=\"mid\">${q.desc}</div>`;\n"
"      mi.onclick=()=>{ closeMenus(); selectReport(q.id); };\n"
"      menu.appendChild(mi);\n"
"    });\n"
"    // Project Plan sits at the top of the Project Management menu (pm+ only -- same RBAC as the old link).\n"
"    if(m==='Project Management' && (rank[role]||1)>=2){\n"
"      const pl=document.createElement('a'); pl.className='mi planlink'; pl.href='/plan';\n"
"      pl.innerHTML='<div>Project Plan</div><div class=\"mid\">Manage a project on the console — add/remove, budget &amp; efficacy, schedule &amp; progress.</div>';\n"
"      menu.insertBefore(pl, menu.firstChild);\n"
"    }\n"
"    g.appendChild(menu); nav.appendChild(g);\n"
"  });\n")

EDITS.append((OLD, NEW, 1))


def run():
    raw = io.open(F, "rb").read().decode("utf-8")
    crlf = "\r\n" in raw
    txt = raw.replace("\r\n", "\n")
    for i, (old, new, n) in enumerate(EDITS, 1):
        if txt.count(old) != n:
            print("ABORT: edit", i, "found", txt.count(old), "expected", n)
            sys.exit(2)
    for old, new, n in EDITS:
        txt = txt.replace(old, new)
    if crlf:
        txt = txt.replace("\n", "\r\n")
    io.open(F, "wb").write(txt.encode("utf-8"))
    print("patched index.html", "CRLF" if crlf else "LF")


run()
